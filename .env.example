# Vegas-MD core settings
BOT_NAME=VEGAS-MD
BOT_VERSION=3.0.0
BOT_PREFIX=.
BOT_MODE=private
OWNER_NUMBER=234XXXXXXXXXX
OWNER_NAME=Your Name

# Existing AI providers (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
ZST_API_KEY=

# New assistant settings (optional; Free Chat is off until enabled with .freechat on)
CODING_AI_MODEL=gpt-4o-mini
FREE_CHAT_AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000

# OpenAI speech generation used by .speak / .generateaudio
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# OPENAI_TTS_INSTRUCTIONS=Warm, friendly, and concise

# David Cyril API integrations (optional; used for Pinterest, visual search, music fallbacks, and AI music)
DAVID_CYRIL_API_BASE=https://apis.davidcyril.name.ng
PINTEREST_API_URL=https://apis.davidcyril.name.ng/search/pinterest
AI_MUSIC_POLL_ATTEMPTS=30
AI_MUSIC_POLL_DELAY_MS=10000

# Secret store: keep this master key in Replit Secrets or the host environment.
# The encrypted .secrets.enc.json file is ignored by git.
SECRET_STORE_KEY=

# Optional ZST DeepAI image fallback used by .imagine after Pollinations fails.
ZST_IMAGE_API_URL=https://api.zstlab.cyou/api/v1/ai/deepai-v2/image
ZST_IMAGE_TIMEOUT_MS=90000
IMAGE_MAX_BYTES=10485760

# Repository-aware vibe coding assistant. Defaults to the directory containing main.js.
REPO_WORKSPACE=.
REPO_MAX_FILE_BYTES=180000
REPO_MAX_CONTEXT_CHARS=11000

# Optional public Invidious base URL used only if yt-dlp is unavailable.
# You can set one reachable instance without changing code.
INVIDIOUS_SEARCH_URL=https://invidious.nerdvpn.de
