# Vegas-MD signed Control Center API (never commit live values)
# Generate the two secrets on a trusted machine and set the identical values
# in Vercel and in the bot process environment.

DASHBOARD_API_ENABLED=true
DASHBOARD_API_PORT=8090
DASHBOARD_API_BIND_HOST=127.0.0.1
BOT_API_SHARED_SECRET=replace-with-a-32-byte-random-secret
BOT_API_SIGNING_SECRET=replace-with-a-different-32-byte-random-secret

# Legacy local dashboard API only. Keep it private or behind a separate access
# layer; it is not used by the Vercel control center.
DASHBOARD_API_KEY=replace-with-a-separate-local-api-key
